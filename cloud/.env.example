# Values printed by:
#   accounts-server register-service jani https://jani.example.com \
#     --client-id jani-cloud --frame-origin https://jani.example.com --logout-path / --format json
# The printed names start with SIWI_; this build reads the IFINSTA_ names below.
IFINSTA_ISSUER=https://accounts.example.com/oidc
IFINSTA_CLIENT_ID=jani-cloud
IFINSTA_CLIENT_SECRET=ifisec_replace_me
IFINSTA_REDIRECT_URI=https://jani.example.com/siwi/callback
IFINSTA_POST_LOGOUT_REDIRECT_URI=https://jani.example.com/
IFINSTA_SCOPES=openid email offline_access

# Shared encrypted session store (build with --features redis). Without it,
# sessions live in memory and end when the container restarts.
# IFINSTA_REDIS_URL=rediss://redis.internal:6379
# IFINSTA_STORE_KEYS=base64-32-byte-key

# Workspace isolation.
JANI_CLOUD_SANDBOX=bwrap
JANI_CLOUD_UID_BASE=40000
JANI_CLOUD_MAX_ACTIVE=8
JANI_CLOUD_IDLE_SECONDS=1800

# What every person's workspace may do. Read-only unless you say otherwise.
# Authority is fixed here; the browser cannot widen it.
JANI_CLOUD_JANI_ARGS=--allow-write --write-path src --api-base https://api.example-model.test/v1 --model your-model-id
JANI_API_KEY=replace-me
