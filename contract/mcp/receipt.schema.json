{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jani.dev/mcp/receipt/v1",
  "title": "Jani MCP Signed Authorization and Disclosure Receipt",
  "type": "object",
  "required": [
    "requestDigest",
    "resultDigest",
    "tenant",
    "initiator",
    "agent",
    "taskId",
    "operation",
    "resource",
    "purpose",
    "role",
    "entitlements",
    "classification",
    "filtered",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "initiator": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "entitlements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED",
        "SECRET"
      ]
    },
    "filtered": {
      "const": true
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "object",
      "required": [
        "keyId",
        "value"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{128}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
